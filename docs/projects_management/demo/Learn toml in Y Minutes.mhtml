<span class=3D"c1"># Whitespace around dot-separated parts is ignored, howe=
ver, best practice is to</span>
<span class=3D"c1"># not use any extraneous whitespace.</span>
<span class=3D"p">[</span><span class=3D"n">a</span><span class=3D"p">.</sp=
an><span class=3D"n">b</span><span class=3D"p">.</span><span class=3D"n">c<=
/span><span class=3D"p">]</span>            <span class=3D"c1"># this is be=
st practice</span>
<span class=3D"p">[</span> <span class=3D"n">d</span><span class=3D"p">.</s=
pan><span class=3D"n">e</span><span class=3D"p">.</span><span class=3D"n">f=
</span> <span class=3D"p">]</span>          <span class=3D"c1"># same as [d=
.e.f]</span>
<span class=3D"p">[</span> <span class=3D"n">j</span> <span class=3D"p">.</=
span> <span class=3D"s">"=CA=9E"</span> <span class=3D"p">.</span> <span cl=
ass=3D"err">'</span><span class=3D"n">l</span><span class=3D"err">'</span> =
<span class=3D"p">]</span>  <span class=3D"c1"># same as [j."=CA=9E".'l']</=
span>

<span class=3D"c1"># You don't need to specify all the super-tables if you =
don't want to. TOML knows</span>
<span class=3D"c1"># how to do it for you.</span>
<span class=3D"c1"># [x] you</span>
<span class=3D"c1"># [x.y] don't</span>
<span class=3D"c1"># [x.y.z] need these</span>
