<span class=3D"p">]</span>

<span class=3D"c1">#########</span>
<span class=3D"c1"># Table #</span>
<span class=3D"c1">#########</span>

<span class=3D"c1"># Tables (or hash tables or dictionaries) are collection=
s of key/value</span>
<span class=3D"c1"># pairs. They appear in square brackets on a line by the=
mselves.</span>
<span class=3D"c1"># Empty tables are allowed and simply have no key/value =
pairs within them.</span>
<span class=3D"p">[</span><span class=3D"n">table</span><span class=3D"p">]=
</span>

<span class=3D"c1"># Under that, and until the next table or EOF are the ke=
y/values of that table.</span>
<span class=3D"c1"># Key/value pairs within tables are not guaranteed to be=
 in any specific order.</span>
<span class=3D"p">[</span><span class=3D"n">table-1</span><span class=3D"p"=
>]</span>
<span class=3D"n">key1</span> <span class=3D"o">=3D</span> <span class=3D"s=
">"some string"</span>
<span class=3D"n">key2</span> <span class=3D"o">=3D</span> <span class=3D"m=
i">123</span>

<span class=3D"p">[</span><span class=3D"n">table-2</span><span class=3D"p"=
>]</span>
<span class=3D"n">key1</span> <span class=3D"o">=3D</span> <span class=3D"s=
">"another string"</span>
<span class=3D"n">key2</span> <span class=3D"o">=3D</span> <span class=3D"m=
i">456</span>

<span class=3D"c1"># Dots are prohibited in bare keys because dots are used=
 to signify nested tables.</span>
<span class=3D"c1"># Naming rules for each dot separated part are the same =
as for keys.</span>
<span class=3D"p">[</span><span class=3D"n">dog</span><span class=3D"p">.</=
span><span class=3D"s">"tater.man"</span><span class=3D"p">]</span>
<span class=3D"n">type</span> <span class=3D"o">=3D</span> <span class=3D"s=
">"pug"</span>

<span class=3D"c1"># In JSON land, that would give you the following struct=
ure:</span>
