<span class=3D"n">array2</span> <span class=3D"o">=3D</span> <span class=3D=
"p">[</span> <span class=3D"s">"Commas"</span><span class=3D"p">,</span> <s=
pan class=3D"s">"are"</span><span class=3D"p">,</span> <span class=3D"s">"d=
elimiters"</span> <span class=3D"p">]</span>
