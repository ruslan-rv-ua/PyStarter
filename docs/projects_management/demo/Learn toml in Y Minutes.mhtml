<span class=3D"n">array1</span> <span class=3D"o">=3D</span> <span class=3D=
"p">[</span> <span class=3D"mi">1</span><span class=3D"p">,</span> <span cl=
ass=3D"mi">2</span><span class=3D"p">,</span> <span class=3D"mi">3</span> <=
